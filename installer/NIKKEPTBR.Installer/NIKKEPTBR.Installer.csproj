<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>NIKKEPTBR</AssemblyName>
    <ApplicationIcon>Assets\kacks-installer.ico</ApplicationIcon>
    <RootNamespace>NIKKEPTBR.Installer</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <FileVersion>0.1.0.0</FileVersion>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\installer-background.png" />
    <Resource Include="Assets\kacks-installer.ico" />
    <EmbeddedResource Include="Assets\THIRD-PARTY-NOTICES.txt"
                      LogicalName="NIKKEPTBR.ThirdPartyNotices.txt" />
    <EmbeddedResource Include="Payload\NIKKEPTBR-bootstrap.zip"
                      LogicalName="NIKKEPTBR.Bootstrap.zip"
                      Condition="Exists('Payload\NIKKEPTBR-bootstrap.zip')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472"
                      Version="1.0.3"
                      PrivateAssets="all" />
  </ItemGroup>
</Project>
